# Copy to .env.local for local development (see docs/EMAIL_SETUP.md).
# These values are public by design: they end up in the browser bundle.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# Also send the visitor a confirmation email (default true)
NEXT_PUBLIC_EMAILJS_SEND_CONFIRMATION=true
# Where enquiries are delivered (default office@786.at)
NEXT_PUBLIC_CONTACT_EMAIL=office@786.at
